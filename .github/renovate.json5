{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'docker:pinDigests',
    'helpers:pinGitHubActionDigestsToSemver',
  ],
  minimumReleaseAge: '7 days',
  internalChecksFilter: 'strict',
  labels: ['dependencies'],
  schedule: ['before 9am on monday'],
  patch: {
    automerge: true,
    // Automerge skips human review, so set longer cooldown
    minimumReleaseAge: '14 days',
  },
  packageRules: [
    {
      // Patch updates are typically non-breaking, so they group and automerge.
      groupName: 'all patch versions',
      matchUpdateTypes: ['patch'],
    },
    {
      groupName: 'all minor versions',
      matchUpdateTypes: ['minor'],
    },
    {
      // hugo-extended is intentionally pinned; updated manually via `npm run update:hugo`.
      matchPackageNames: ['hugo-extended'],
      enabled: false,
    },
    {
      // Version-exact allowScripts approvals (package.json) need a human to
      // refresh the entry with the bump, so approved packages never automerge.
      matchPackageNames: ['puppeteer'],
      automerge: false,
    },
  ],
}
