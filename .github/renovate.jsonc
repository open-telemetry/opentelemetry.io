{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigestsToSemver",
  ],
  // For details about this repo's settings, see
  // https://opentelemetry.io/site/build/dependencies/
  "ignorePresets": ["security:minimumReleaseAgeNpm"],
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": { "enabled": false },
  "labels": ["dependencies"],
  "schedule": ["before 9am on monday"],
  "patch": {
    "automerge": true,
    "minimumReleaseAge": "14 days",
  },
  "packageRules": [
    {
      "groupName": "all patch versions",
      "matchUpdateTypes": ["patch"],
    },
    {
      "groupName": "all minor versions",
      "matchUpdateTypes": ["minor"],
    },
    {
      // Bumped by hand: https://opentelemetry.io/site/build/dependencies/#hugo
      "matchPackageNames": ["hugo-extended"],
      "enabled": false,
    },
    {
      // Restores Renovate's own group:puppeteer, which the shared group rules
      // above override; keep this rule below them. Rationale:
      // https://opentelemetry.io/site/build/dependencies/#script-bearing-packages
      // puppeteer-core moves in lockstep with puppeteer.
      "matchPackageNames": ["puppeteer", "puppeteer-core"],
      "groupName": "Puppeteer",
      "automerge": false,
    },
    {
      // The @opentelemetry/* packages peer-pin @opentelemetry/api to a single
      // minor, so a coordinated SDK release installs only as a complete set:
      // one group across update types, kept below the shared group rules above.
      // Rationale:
      // https://opentelemetry.io/site/build/dependencies/#peer-coupled-packages
      "matchPackageNames": ["@opentelemetry/**"],
      "groupName": "OpenTelemetry",
      "separateMajorMinor": false,
    },
  ],
}
