# Supply-chain hardening after the 2026-08 incident:
# https://github.com/open-telemetry/opentelemetry.io/issues/11210

# Delay new releases for 3 days so registry-side takedowns have time to land.
min-release-age=3

# Run lifecycle scripts only for exact package versions in `allowScripts`.
# Installs with --ignore-scripts run no lifecycle scripts.
strict-allow-scripts=true

# Fail rather than silently ignoring the lifecycle-script allowlist and release
# cooldown when the active npm version is older than the package engines floor.
engine-strict=true
