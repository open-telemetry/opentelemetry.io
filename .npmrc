# Post-incident supply-chain hardening (2026-08): only allow package versions
# that have been published for at least 3 days, so that registry-side takedowns
# of malicious releases have time to land before we resolve them.
min-release-age=3

# Post-incident supply-chain hardening (2026-08): lifecycle scripts run only
# for packages pinned in the package.json `allowScripts` allowlist. Note that
# this has no effect on installs run with --ignore-scripts.
strict-allow-scripts=true

# Fail rather than silently ignoring the lifecycle-script allowlist and release
# cooldown when the active npm version is older than the package engines floor.
engine-strict=true
